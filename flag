<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vietnam Flag</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #ff0000; /* Red background for the flag */
        }

        .flag {
            position: relative;
            width: 300px; /* Adjust width for the flag */
            height: 200px; /* Adjust height for the flag */
            background-color: #ff0000; /* Red background */
        }

        .star {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 180px; /* Increase this value to make the star larger */
            height: 180px; /* Increase this value to make the star larger */
            background: yellow;
            clip-path: polygon(
                50% 0%,
                61% 35%,
                98% 35%,
                68% 57%,
                79% 91%,
                50% 70%,
                21% 91%,
                32% 57%,
                2% 35%,
                39% 35%
            );
            transform: translate(-50%, -50%);
        }
    </style>
</head>
<body>
    <div class="flag">
        <div class="star"></div>
    </div>
</body>
</html>
